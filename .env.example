# Copia este archivo como .env solo si quieres configurar algo (el servidor funciona sin .env).
# Render define PORT automaticamente.
PORT=3000
# Origenes permitidos para Socket.IO, separados por coma. "*" = cualquiera (lo normal para un APK/WebView).
ALLOWED_ORIGINS=*
# Maximo de salas simultaneas y de conexiones simultaneas (proteccion basica)
MAX_ROOMS=500
MAX_CONNECTIONS=1000
